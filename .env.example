# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role secret — bypasses RLS. Used only server-side by the public
# progress page (lib/supabase/admin.ts). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string gating /review/<token>/... — the unlisted, share-with-
# specific-people read-only dashboard clone. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REVIEW_ACCESS_TOKEN=

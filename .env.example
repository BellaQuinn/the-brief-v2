# Supabase — from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role secret — bypasses RLS. Used only server-side by the public
# progress page (lib/supabase/admin.ts). Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Long random string gating /review/<token>/... — the unlisted, share-with-
# specific-people read-only dashboard clone. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REVIEW_ACCESS_TOKEN=

# Web Push — generate once with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# The public key is safe client-side; the private key must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Authorizes the daily reminder cron route (see vercel.json) — set the
# same value here and in Vercel's env vars; Vercel's cron caller sends it
# as a bearer token, and /api/cron/notifications rejects anything else.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Syllabus Intelligence (app/api/documents/extract) — a standalone API key
# from console.anthropic.com, separate from any Claude subscription. Used
# server-side only; never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
